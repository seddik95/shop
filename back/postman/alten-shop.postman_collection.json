{
  "info": { "name": "Alten Shop API", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "productId", "value": "" }
  ],
  "item": [
    { "name": "Register user", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "url": "{{baseUrl}}/account",
      "body": { "mode": "raw", "raw": "{\"username\":\"john\",\"firstname\":\"John\",\"email\":\"john@x.com\",\"password\":\"secret1\"}" } },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('201 or 409', () => pm.expect([201,409]).to.include(pm.response.code));"] } }] },
    { "name": "Register admin", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "url": "{{baseUrl}}/account",
      "body": { "mode": "raw", "raw": "{\"username\":\"admin\",\"firstname\":\"Admin\",\"email\":\"admin@admin.com\",\"password\":\"secret1\"}" } },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('201 or 409', () => pm.expect([201,409]).to.include(pm.response.code));"] } }] },
    { "name": "Token (user)", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "url": "{{baseUrl}}/token",
      "body": { "mode": "raw", "raw": "{\"email\":\"john@x.com\",\"password\":\"secret1\"}" } },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('200', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('token', pm.response.json().token);"] } }] },
    { "name": "Token (admin)", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "url": "{{baseUrl}}/token",
      "body": { "mode": "raw", "raw": "{\"email\":\"admin@admin.com\",\"password\":\"secret1\"}" } },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('200', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('adminToken', pm.response.json().token);"] } }] },
    { "name": "Token wrong password -> 401", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "url": "{{baseUrl}}/token",
      "body": { "mode": "raw", "raw": "{\"email\":\"john@x.com\",\"password\":\"wrong\"}" } },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('401', () => pm.response.to.have.status(401));"] } }] },
    { "name": "Products without token -> 401", "request": { "method": "GET", "url": "{{baseUrl}}/products" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('401', () => pm.response.to.have.status(401));"] } }] },
    { "name": "Products (user)", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": "{{baseUrl}}/products" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('200', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('productId', pm.response.json()[0].id);"] } }] },
    { "name": "Create product as user -> 403", "request": { "method": "POST", "header": [{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}], "url": "{{baseUrl}}/products",
      "body": { "mode": "raw", "raw": "{\"code\":\"c1\",\"name\":\"Test\",\"price\":10,\"quantity\":3,\"inventoryStatus\":\"INSTOCK\"}" } },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('403', () => pm.response.to.have.status(403));"] } }] },
    { "name": "Create product as admin -> 201", "request": { "method": "POST", "header": [{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}], "url": "{{baseUrl}}/products",
      "body": { "mode": "raw", "raw": "{\"code\":\"c1\",\"name\":\"Test\",\"price\":10,\"quantity\":3,\"inventoryStatus\":\"INSTOCK\"}" } },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('201', () => pm.response.to.have.status(201));"] } }] },
    { "name": "Add to cart", "request": { "method": "POST", "header": [{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}], "url": "{{baseUrl}}/cart",
      "body": { "mode": "raw", "raw": "{\"productId\":{{productId}},\"quantity\":2}" } },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('201', () => pm.response.to.have.status(201));"] } }] },
    { "name": "Get cart", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": "{{baseUrl}}/cart" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('has items', () => pm.expect(pm.response.json().length).to.be.above(0));"] } }] },
    { "name": "Update cart quantity", "request": { "method": "PATCH", "header": [{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}], "url": "{{baseUrl}}/cart/{{productId}}",
      "body": { "mode": "raw", "raw": "{\"quantity\":5}" } },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('quantity 5', () => pm.expect(pm.response.json().quantity).to.eql(5));"] } }] },
    { "name": "Remove from cart", "request": { "method": "DELETE", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": "{{baseUrl}}/cart/{{productId}}" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('204', () => pm.response.to.have.status(204));"] } }] },
    { "name": "Add to wishlist", "request": { "method": "POST", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": "{{baseUrl}}/wishlist/{{productId}}" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('201', () => pm.response.to.have.status(201));"] } }] },
    { "name": "Get wishlist", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": "{{baseUrl}}/wishlist" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('has items', () => pm.expect(pm.response.json().length).to.be.above(0));"] } }] },
    { "name": "Remove from wishlist", "request": { "method": "DELETE", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": "{{baseUrl}}/wishlist/{{productId}}" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('204', () => pm.response.to.have.status(204));"] } }] }
  ]
}